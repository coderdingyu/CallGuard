# Hugging Face token with read access, used only by local download scripts.
HF_TOKEN=

# Local data root. Keep large datasets outside Git.
CALLGUARD_DATA_ROOT=./data

# Local SQLite path. Cloud containers can point this to a mounted disk path.
CALLGUARD_DB_PATH=./data/local/callguard.db

# Deployment profile.
# 0/local-full: full local machine learning demo with local model files.
# 1/cloud-demo: lightweight public demo without uploading large datasets or model binaries.
CALLGUARD_DEMO_MODE=0
CALLGUARD_DEPLOYMENT_MODE=local-full

# Comma-separated origins allowed to call the API.
CALLGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local FastAPI endpoint used by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Optional: force a specific local faster-whisper model directory.
# By default the API prefers faster-whisper-small, then base, then tiny.
CALLGUARD_ASR_MODEL_PATH=
