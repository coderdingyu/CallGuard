FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CALLGUARD_DEMO_MODE=1 \
    CALLGUARD_DEPLOYMENT_MODE=cloud-demo \
    CALLGUARD_DB_PATH=/data/callguard.db

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt apps/api/requirements.txt
RUN python -m pip install --no-cache-dir -U pip \
    && python -m pip install --no-cache-dir -r apps/api/requirements.txt

COPY apps/api apps/api
COPY ml/src ml/src
COPY ml/configs ml/configs
COPY ml/models ml/models
COPY data/external data/external

RUN mkdir -p /data

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8001"]
